# Copy this file to .env.production on the production server.
# Replace every value marked CHANGE_ME and never commit the resulting file.
POSTGRES_USER=netsuro
POSTGRES_DB=netsuro_monitor
ADMIN_EMAIL=CHANGE_ME@example.com
POSTGRES_PASSWORD_SECRET_FILE=./secrets/postgres_password.txt
ADMIN_PASSWORD_SECRET_FILE=./secrets/admin_password.txt
SLACK_WEBHOOK_SECRET_FILE=./secrets/slack_webhook_url.txt
APP_ENV=production
COOKIE_SECURE=true
CHECK_RETENTION_DAYS=90
SYSTEM_RETENTION_DAYS=90
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
MONITOR_ALLOWED_PORTS=80,443
MONITOR_ALLOWED_PRIVATE_HOSTS=
TRUST_PROXY_HEADERS=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_HOUR=20
RATE_LIMIT_HEARTBEAT_PER_MINUTE=30
RATE_LIMIT_HEARTBEAT_IP_PER_MINUTE=300
RATE_LIMIT_MANUAL_CHECK_PER_MINUTE=5
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_READ_PER_MINUTE=300
RATE_LIMIT_LIVENESS_PER_MINUTE=120
ALLOWED_ORIGINS=https://monitor.netsuro.com
ALLOWED_HOSTS=monitor.netsuro.com,api,localhost,127.0.0.1
REQUIRE_ORIGIN=true
